---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const allBlogPosts = await getCollection('blog');
const sortedPosts = allBlogPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Get all unique tags
const allTags = [...new Set(allBlogPosts.flatMap(post => post.data.tags || []))];
---

<BaseLayout title="Blog - Asika (tyngw)" description="Articles about software testing, QA, and test automation">
  <div class="max-w-6xl mx-auto">
    <header class="mb-12">
      <h1 class="text-4xl font-bold mb-4 text-gray-900">Blog</h1>
      <p class="text-lg text-gray-600">
        Thoughts and insights on software testing, quality assurance, and test automation
      </p>
    </header>

    {allTags.length > 0 && (
      <div class="mb-8">
        <h2 class="text-sm font-semibold text-gray-700 mb-3">Tags:</h2>
        <div class="flex flex-wrap gap-2">
          {allTags.map((tag) => (
            <span class="px-3 py-1 bg-white border border-gray-300 text-gray-700 rounded-full text-sm hover:bg-gray-50 cursor-pointer">
              {tag}
            </span>
          ))}
        </div>
      </div>
    )}

    {sortedPosts.length === 0 ? (
      <div class="text-center py-16 bg-white rounded-lg shadow-md">
        <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <h2 class="text-xl font-semibold text-gray-700 mb-2">No blog posts yet</h2>
        <p class="text-gray-500">Check back soon for new content!</p>
      </div>
    ) : (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedPosts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.slug}
            tags={post.data.tags}
          />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
