---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allBlogPosts = await getCollection('blog');
const recentPosts = allBlogPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const allPortfolio = await getCollection('portfolio');
const featuredProjects = allPortfolio
  .filter(item => item.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Asika (tyngw) - Software Testing Enthusiast">
  <div class="space-y-16">
    <!-- Hero Section -->
    <section class="text-center py-12">
      <h1 class="text-5xl font-bold mb-4 text-gray-900">
        Hi there, I'm <span class="text-primary-600">Asika (tyngw)</span>
      </h1>
      <p class="text-2xl text-gray-600 mb-8">Software Testing Enthusiast</p>
      <p class="text-lg text-gray-700 max-w-3xl mx-auto leading-relaxed">
        Welcome to my portfolio! I'm passionate about <strong>software testing</strong>, <strong>quality assurance</strong>,
        and exploring how <strong>AI can support test design</strong>. I have over 10 years of experience working on testing
        strategies, automation, and defect analysis.
      </p>
    </section>

    <!-- What I Do Section -->
    <section class="bg-white rounded-lg shadow-md p-8">
      <h2 class="text-3xl font-bold mb-6 text-gray-900">What I Do</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="p-6 bg-gradient-to-br from-primary-50 to-primary-100 rounded-lg">
          <div class="text-primary-600 mb-4">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Software Testing & QA</h3>
          <p class="text-gray-700">Expert in testing strategies, quality assurance, and defect analysis</p>
        </div>

        <div class="p-6 bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg">
          <div class="text-blue-600 mb-4">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Test Automation</h3>
          <p class="text-gray-700">Proficient with MagicPod, Autify, Playwright, Selenium</p>
        </div>

        <div class="p-6 bg-gradient-to-br from-purple-50 to-purple-100 rounded-lg">
          <div class="text-purple-600 mb-4">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">AI & Innovation</h3>
          <p class="text-gray-700">Experimenting with AI for test case generation using ChatGPT</p>
        </div>
      </div>
    </section>

    <!-- Highlights Section -->
    <section>
      <h2 class="text-3xl font-bold mb-6 text-gray-900">Highlights</h2>
      <div class="space-y-4">
        <div class="bg-white border-l-4 border-yellow-500 p-6 rounded-lg shadow-md">
          <div class="flex items-start">
            <span class="text-2xl mr-4">🏆</span>
            <div>
              <h3 class="font-semibold text-lg mb-1">Winner of the 2023 Software Test Design Competition (Solo Entry)</h3>
              <p class="text-gray-600">Recognized for excellence in test design methodology and implementation</p>
            </div>
          </div>
        </div>

        <div class="bg-white border-l-4 border-blue-500 p-6 rounded-lg shadow-md">
          <div class="flex items-start">
            <span class="text-2xl mr-4">🎤</span>
            <div>
              <h3 class="font-semibold text-lg mb-1">IEEE ISSRE 2024 ASTER SESSION Speaker</h3>
              <p class="text-gray-600">Presented at the International Symposium on Software Reliability Engineering (October 29, 2024)</p>
              <a href="https://issre.github.io/2024/ss_program_aster.html" target="_blank" class="text-primary-600 hover:text-primary-700 text-sm mt-1 inline-block">
                View Conference →
              </a>
            </div>
          </div>
        </div>

        <div class="bg-white border-l-4 border-green-500 p-6 rounded-lg shadow-md">
          <div class="flex items-start">
            <span class="text-2xl mr-4">🎤</span>
            <div>
              <h3 class="font-semibold text-lg mb-1">JaSST'25 Tokyo Speaker</h3>
              <p class="text-gray-600">Session A7 presenter (March 28, 2025)</p>
              <a href="https://jasst.jp/symposium/jasst25tokyo/pdf/A7.pdf" target="_blank" class="text-primary-600 hover:text-primary-700 text-sm mt-1 inline-block">
                View Details →
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Certifications Section -->
    <section class="bg-white rounded-lg shadow-md p-8">
      <h2 class="text-3xl font-bold mb-6 text-gray-900">Certifications</h2>
      <div class="grid md:grid-cols-2 gap-4">
        <div class="flex items-center p-4 border border-gray-200 rounded-lg">
          <svg class="w-8 h-8 text-primary-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
          </svg>
          <div>
            <p class="font-semibold">Fundamental IT Engineer (IPA)</p>
            <p class="text-sm text-gray-600">2007</p>
          </div>
        </div>

        <div class="flex items-center p-4 border border-gray-200 rounded-lg">
          <svg class="w-8 h-8 text-primary-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
          </svg>
          <div>
            <p class="font-semibold">Applied IT Engineer (IPA)</p>
            <p class="text-sm text-gray-600">2010</p>
          </div>
        </div>

        <div class="flex items-center p-4 border border-gray-200 rounded-lg">
          <svg class="w-8 h-8 text-primary-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
          </svg>
          <div>
            <p class="font-semibold">Registered Scrum Master™</p>
            <p class="text-sm text-gray-600">Scrum Inc., 2019</p>
          </div>
        </div>

        <div class="flex items-center p-4 border border-gray-200 rounded-lg">
          <svg class="w-8 h-8 text-primary-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
          </svg>
          <div>
            <p class="font-semibold">Registered Product Owner™</p>
            <p class="text-sm text-gray-600">Scrum Inc., 2021</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Projects -->
    {featuredProjects.length > 0 && (
      <section>
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-3xl font-bold text-gray-900">Featured Projects</h2>
          <a href="/portfolio" class="text-primary-600 hover:text-primary-700 font-medium">
            View all →
          </a>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {featuredProjects.map((project) => (
            <div>Featured project: {project.data.title}</div>
          ))}
        </div>
      </section>
    )}

    <!-- Recent Blog Posts -->
    {recentPosts.length > 0 && (
      <section>
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-3xl font-bold text-gray-900">Recent Blog Posts</h2>
          <a href="/blog" class="text-primary-600 hover:text-primary-700 font-medium">
            View all →
          </a>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {recentPosts.map((post) => (
            <div>Recent post: {post.data.title}</div>
          ))}
        </div>
      </section>
    )}

    <!-- Connect Section -->
    <section class="bg-gradient-to-r from-primary-600 to-blue-600 text-white rounded-lg shadow-lg p-8 text-center">
      <h2 class="text-3xl font-bold mb-4">Let's Connect!</h2>
      <p class="text-lg mb-6">
        Interested in software testing, quality assurance, or collaborating on projects? Feel free to reach out!
      </p>
      <div class="flex justify-center gap-4">
        <a
          href="https://x.com/tyngw"
          target="_blank"
          class="px-6 py-3 bg-white text-primary-600 rounded-lg font-semibold hover:bg-gray-100 transition-colors"
        >
          Follow on X
        </a>
        <a
          href="https://tyngw.hatenablog.com"
          target="_blank"
          class="px-6 py-3 bg-transparent border-2 border-white text-white rounded-lg font-semibold hover:bg-white hover:text-primary-600 transition-colors"
        >
          Read My Blog
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
