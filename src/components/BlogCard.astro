---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags?: string[];
}

const { title, description, pubDate, slug, tags } = Astro.props;
---

<article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
  <div class="p-6">
    <div class="flex items-center text-sm text-gray-500 mb-2">
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString('ja-JP', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
    </div>

    <h3 class="text-xl font-semibold mb-2">
      <a href={`/blog/${slug}`} class="text-gray-900 hover:text-primary-600">
        {title}
      </a>
    </h3>

    <p class="text-gray-600 mb-4 line-clamp-3">
      {description}
    </p>

    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-4">
        {tags.map((tag) => (
          <a
            href={`/blog/tag/${tag}`}
            class="px-2 py-1 bg-gray-100 text-gray-700 rounded text-xs hover:bg-primary-100 hover:text-primary-700 transition-colors"
          >
            {tag}
          </a>
        ))}
      </div>
    )}

    <a
      href={`/blog/${slug}`}
      class="inline-flex items-center text-primary-600 hover:text-primary-700 font-medium text-sm"
    >
      続きを読む
      <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</article>
