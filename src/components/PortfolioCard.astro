---
interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags?: string[];
  link?: string;
  image?: string;
  featured?: boolean;
}

const { title, description, date, slug, tags, link, image, featured } = Astro.props;
---

<article class={`bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300 ${featured ? 'border-2 border-primary-500' : ''}`}>
  {image && (
    <div class="aspect-video overflow-hidden">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
      />
    </div>
  )}

  <div class="p-6">
    {featured && (
      <span class="inline-block px-3 py-1 bg-primary-500 text-white text-xs font-semibold rounded-full mb-3">
        Featured
      </span>
    )}

    <div class="flex items-center text-sm text-gray-500 mb-2">
      <time datetime={date.toISOString()}>
        {date.toLocaleDateString('ja-JP', {
          year: 'numeric',
          month: 'long',
        })}
      </time>
    </div>

    <h3 class="text-xl font-semibold mb-2 text-gray-900">
      {title}
    </h3>

    <p class="text-gray-600 mb-4">
      {description}
    </p>

    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-4">
        {tags.map((tag) => (
          <span class="px-2 py-1 bg-gray-100 text-gray-700 rounded text-xs">
            {tag}
          </span>
        ))}
      </div>
    )}

    <div class="flex gap-3">
      {link && (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center text-primary-600 hover:text-primary-700 font-medium text-sm"
        >
          リンクを見る
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
    </div>
  </div>
</article>
